# Makefile pentru proiectul SnakeGame
# Autor: Rotaru Daniel
# An: 2024

# Compilator și opțiuni
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -pedantic

# Nume executabil
TARGET = SnakeGame

# Directoare
OBJ_DIR = obj
LIB_DIR = lib

# Fișiere sursă și obiecte
SRC = apple.cpp board.cpp point.cpp snake.cpp
OBJ = $(SRC:%.cpp=$(OBJ_DIR)/%.o)

# Biblioteci
STATIC_LIBS = $(LIB_DIR)/libPoint.a $(LIB_DIR)/libApple.a $(LIB_DIR)/libBoard.a $(LIB_DIR)/libSnake.a
DYNAMIC_LIBS = $(LIB_DIR)/libPoint.so $(LIB_DIR)/libApple.so $(LIB_DIR)/libBoard.so $(LIB_DIR)/libSnake.so

# Reguli principale
all: $(STATIC_LIBS) $(DYNAMIC_LIBS) $(TARGET)

$(TARGET): main.o $(STATIC_LIBS)
	$(CXX) $(CXXFLAGS) -o $@ main.o -L$(LIB_DIR) -lPoint -lApple -lBoard -lSnake

main.o: main.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(LIB_DIR)/lib%.a: $(OBJ_DIR)/%.o
	@mkdir -p $(LIB_DIR)
	ar rcs $@ $<

$(LIB_DIR)/lib%.so: $(OBJ_DIR)/%.o
	@mkdir -p $(LIB_DIR)
	$(CXX) -shared -o $@ $<

# Regula pentru curățare
clean:
	rm -rf $(OBJ_DIR) $(LIB_DIR) $(TARGET) main.o